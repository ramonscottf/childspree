{
  "name": "childspree",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:native": "CAPACITOR=1 vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist",
    "cap:sync": "npm run build:native && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "db:create": "wrangler d1 create childspree-db",
    "db:migrate": "wrangler d1 execute childspree-db --file=schema.sql",
    "db:migrate:local": "wrangler d1 execute childspree-db --local --file=schema.sql"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.6.3",
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/push-notifications": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "html5-qrcode": "^2.3.8",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.1",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^6.0.3",
    "vite": "5.4.21",
    "wrangler": "^3.0.0"
  }
}
